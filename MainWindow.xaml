<Window x:Class="Bongs_Vehicle_Viewer_V2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bongs_Vehicle_Viewer_V2" 
        xmlns:customcontrols="clr-namespace:Bongs_Vehicle_Viewer_V2.Resources.CustomControls"
        mc:Ignorable="d"
        Icon="/Resources/Images/Icons/Car_Sport.png" Title="Bongs Vehicle Viewer" Height="480" MinHeight="400" Width="640" WindowStartupLocation="CenterScreen">
    
    <Grid x:Name="rootGrid"  Background="DarkGray">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu x:Name="menuBar">
            <MenuItem Header="File">
                <MenuItem Header="New" InputGestureText="Ctrl+N" Click="OnNewBtnPress">
                    <MenuItem.Icon>
                        <Image Source="/Resources/Images/Icons/Plus.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open" InputGestureText="Ctrl+O" Click="OnOpenBtnPress">
                    <MenuItem.Icon>
                        <Image Source="/Resources/Images/Icons/Share.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Save" InputGestureText="Ctrl+S" Click="OnSaveBtnPress">
                    <MenuItem.Icon>
                        <Image Source="/Resources/Images/Icons/Save.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save As" InputGestureText="Ctrl+E" Click="OnSaveAsBtnPress">
                    <MenuItem.Icon>
                        <Image Source="/Resources/Images/Icons/Save.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Quit" InputGestureText="Crtl+X" Click="OnExitBtnPress">
                    <MenuItem.Icon>
                        <Image Source="/Resources/Images/Icons/Door.png"></Image>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Options">
                <MenuItem x:Name="btnContainerTheme" Header="Theme" StaysOpenOnClick="False">
                    <RadioButton Content="Standard" GroupName="dBugThemeBtns" IsChecked="False" Checked="OnDebugThemeChange"/>
                    <RadioButton Content="Gameboy" GroupName="dBugThemeBtns" IsChecked="False" Checked="OnDebugThemeChange"/>
                    <RadioButton Content="Matrix" GroupName="dBugThemeBtns" IsChecked="True" Checked="OnDebugThemeChange"/>
                    <RadioButton Content="Neon" GroupName="dBugThemeBtns" IsChecked="False" Checked="OnDebugThemeChange"/>
                </MenuItem>     
            </MenuItem>
        </Menu>
        
        <TabControl x:Name="tabControl" Grid.Row="1" Margin="4">
            <TabItem Header="Vehicles">
                <Grid Background="WhiteSmoke">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                       
                        <ScrollViewer x:Name="propertyScrollView"  Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="1,8">
                            <Grid x:Name="propertyGrid" Width="128" Margin="4,4,8,4" HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <customcontrols:LabeledSelector x:Name="typeSelector" Grid.Row="0" LabelContent="Class" SelectionChanged="OnTypeChange"/>
                                <customcontrols:LabeledSelector x:Name="yearSelector" Grid.Row="1" LabelContent="Year"/>
                                <customcontrols:LabeledTextBox x:Name="makeTextBox" Grid.Row="2" LabelContent="Make"/>
                                <customcontrols:LabeledTextBox x:Name="modelTextBox" Grid.Row="3" LabelContent="Model"/>
                                <customcontrols:LabeledTextBox x:Name="priceTextBox" Grid.Row="4" LabelContent="Price" IsNumericField="True"/>
                                <customcontrols:LabeledSelector x:Name="stateSelector" Grid.Row="5" LabelContent="Condition"/>
                                <customcontrols:LabeledSelector x:Name="fuelSelector" Grid.Row="6" LabelContent="FuelType"/>
                                <Grid x:Name="extendedGrid" Grid.Row="7" Margin="0,2,0,0"></Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Storage:" Padding="3"/>
                            <TextBox x:Name="nameInput" Grid.Column="1" Width="180" Margin="2" KeyDown="OnStorageNameChange" IsEnabled="False"/>
                            <Label x:Name="vehicleIDLabel" Content="Next ID: 100200"  Grid.Column="2" HorizontalAlignment="Right"/>
                        </Grid>

                        <DataGrid x:Name="dataGrid" Grid.Row="1" Margin="2" Background="White" IsReadOnly="True" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto" SelectionMode="Single" AutoGenerateColumns="False" HeadersVisibility="Column" SelectionChanged="OnVehicleSelected">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" MinWidth="64" Width="Auto" Binding="{Binding ID}"/>
                                <DataGridTextColumn Header="Year" MinWidth="64" Width="Auto" Binding="{Binding Year}"/>
                                <DataGridTextColumn Header="Class" MinWidth="80" Width="Auto" Binding="{Binding Class}"/>
                                <DataGridTextColumn Header="Make" MinWidth="80" Width="Auto" Binding="{Binding Make}"/>
                                <DataGridTextColumn Header="Model" MinWidth="80" Width="Auto" Binding="{Binding Model}"/>
                                <DataGridTextColumn Header="Price" MinWidth="80" Width="Auto" Binding="{Binding Price, StringFormat=C}"/>
                                <DataGridTextColumn Header="Condition" MinWidth="70" Width="Auto" Binding="{Binding Condition}"/>
                                <DataGridTextColumn Header="FuelType" MinWidth="70" Width="Auto" Binding="{Binding FuelType}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid Grid.Row="1" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="1,6" VerticalAlignment="Center">
                            <Button x:Name="submitBtn" Content="Submit" Width="64" Margin="4,1" FontSize="12" Click="OnSubmitBtnPress"/>
                            <Button x:Name="resetBtn" Content="Clear" Width="64" Margin="4,1" FontSize="12" Click="OnResetBtnPress"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="1,6" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Button x:Name="removeBtn" Content="Remove" Width="64" Margin="4,1" FontSize="12" Click="OnRemoveBtnPress" IsEnabled="False"/>
                            <TextBox x:Name="searchBar" MinWidth="140" Margin="6,0,6,0" Height="20" KeyDown="OnSearchBarSubmit"/>
                            <Button x:Name="unselectBtn" Content="Unselect" Width="64" Margin="4,1" FontSize="12" Click="OnUnselectBtnPress" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Statistics">
                <Grid Background="WhiteSmoke">
                    <Border BorderBrush="DarkGray" BorderThickness="2" HorizontalAlignment="Stretch">
                        <StackPanel x:Name="trackPanel" Background="WhiteSmoke">
                            <Label x:Name="storageTracker" Content="Storage: Empty"/>
                            <Label x:Name="motorizedTracker" Content="Motorized Vehicles: 0"/>
                            <Label x:Name="aquaticTracker" Content="Aquatic Vehicles: 0"/>
                            <Label x:Name="aerialTracker" Content="Aerial Vehicles: 0"/>
                            <Label x:Name="totalTracker" Content="Total Vehicles: 0"/>
                            <Label x:Name="priceTracker" Content="Total Price: 0"/>
                            <Label x:Name="milesTracker" Content="Total Miles: 0"/>
                        </StackPanel>
                    </Border>
                   
                </Grid>
            </TabItem>
            
            <TabItem Header="Debug">
                <Grid Background="#FFE5E5E5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="filenameTracker" Content="File Name: Undefined" Grid.Column="0"/>
                            <Label x:Name="fileSaveTracker" Content="Last Save: 00:00:00 AM" Grid.Column="1"/>
                        </Grid>
                        <Separator/>
                        <Label x:Name="directoryTracker" Content="Save Directory: Undefined"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <TextBlock x:Name="debugOutput" Background="Black" Foreground="Lime" Margin="4" Padding="6" Text="" TextWrapping="Wrap" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </ScrollViewer>
                    <Grid Grid.Row="2">
                        <TextBox x:Name="debugInput" Margin="4,0,20,0" Text="" KeyDown="HandleDebugInput"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <customcontrols:BongsStatusBar x:Name="statusBar" Grid.Row="2"/>
    </Grid>
</Window>
