<Window x:Class="Bongs_Vehicle_Viewer_V2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bongs_Vehicle_Viewer_V2" 
        xmlns:customcontrols="clr-namespace:Bongs_Vehicle_Viewer_V2.Resources.CustomControls"
        mc:Ignorable="d"
        Icon="/Resources/Images/car_sport.png" Title="Bongs Vehicle Viewer" Height="488" MinHeight="488" Width="640" WindowStartupLocation="CenterScreen">
    
    <Grid x:Name="rootGrid"  Background="DarkGray">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu>
            <MenuItem Header="File">
                <MenuItem Header="New" InputGestureText="Ctrl+N" Click="OnNewBtnPress"></MenuItem>
                <MenuItem Header="Open" InputGestureText="Ctrl+O" Click="OnOpenBtnPress"></MenuItem>
                <Separator/>
                <MenuItem Header="Save" InputGestureText="Ctrl+S" Click="OnSaveBtnPress"></MenuItem>
                <MenuItem Header="Save As" InputGestureText="Ctrl+E" Click="OnSaveAsBtnPress"></MenuItem>
                <MenuItem Header="Quit" InputGestureText="Crtl+X" Click="OnExitBtnPress"></MenuItem>
            </MenuItem>

            <MenuItem Header="Options"></MenuItem>
        </Menu>
        
        <TabControl x:Name="tabControl" Grid.Row="1" Margin="2">
            <TabItem Header="Vehicles">
                <Grid Background="WhiteSmoke">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ScrollBar x:Name="propertyScrollBar" Grid.Column="0" HorizontalAlignment="Left" Visibility="Visible" ValueChanged="OnPropScrollValueChange"/>
                        <ScrollViewer x:Name="propertyScrollView" Grid.Column="1" VerticalScrollBarVisibility="Hidden" ScrollChanged="OnPropScrollChanged">
                            <Grid x:Name="propertyGrid" Margin="6" Width="120" HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <customcontrols:LabeledSelector x:Name="typeSelector" Grid.Row="0" LabelContent="Class" SelectionChanged="OnTypeChange"/>
                                <customcontrols:LabeledSelector x:Name="yearSelector" Grid.Row="1" LabelContent="Year"/>
                                <customcontrols:LabeledTextBox x:Name="makeTextBox" Grid.Row="2" LabelContent="Make"/>
                                <customcontrols:LabeledTextBox x:Name="modelTextBox" Grid.Row="3" LabelContent="Model"/>
                                <customcontrols:LabeledTextBox x:Name="priceTextBox" Grid.Row="4" LabelContent="Price" IsNumericField="True"/>
                                <customcontrols:LabeledSelector x:Name="stateSelector" Grid.Row="5" LabelContent="Condition"/>
                                <customcontrols:LabeledSelector x:Name="fuelSelector" Grid.Row="6" LabelContent="FuelType"/>
                                <Grid x:Name="extendedGrid" Grid.Row="7" Margin="0,2,0,0"></Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Label Content="Name:" Padding="3"/>
                            <TextBox x:Name="nameTracker" Width="180" Margin="2" KeyDown="OnStorageNameChange" IsEnabled="False"/>
                        </StackPanel>
                        <DataGrid x:Name="dataGrid" Grid.Row="1" Background="GhostWhite"  IsReadOnly="True" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto" SelectionMode="Single" AutoGenerateColumns="False" HeadersVisibility="Column" SelectionChanged="OnVehicleSelected">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" MinWidth="64" Width="Auto" Binding="{Binding ID}"/>
                                <DataGridTextColumn Header="Class" MinWidth="80" Width="Auto" Binding="{Binding Class}"/>
                                <DataGridTextColumn Header="Make" MinWidth="80" Width="Auto" Binding="{Binding Make}"/>
                                <DataGridTextColumn Header="Model" MinWidth="80" Width="Auto" Binding="{Binding Model}"/>
                                <DataGridTextColumn Header="Year" MinWidth="72" Width="Auto" Binding="{Binding Year}"/>
                                <DataGridTextColumn Header="Price" MinWidth="80" Width="Auto" Binding="{Binding Price, StringFormat=C}"/>
                                <DataGridTextColumn Header="Condition" MinWidth="64" Width="Auto" Binding="{Binding Condition}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid Grid.Row="1" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="2" VerticalAlignment="Center">
                            <Button x:Name="submitBtn" Content="Submit" Width="64" Margin="4,2" FontSize="12" Click="OnSubmitBtnPress"/>
                            <Button x:Name="resetBtn" Content="Clear" Width="64" Margin="4,2" FontSize="12" Click="OnResetBtnPress"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6" VerticalAlignment="Center">
                            <Button x:Name="removeBtn" Content="Remove" Width="64" Margin="4,1" FontSize="12" Click="OnRemoveBtnPress" IsEnabled="False"/>
                            <Button x:Name="unselectBtn" Content="Unselect" Width="64" Margin="4,1" FontSize="12" Click="OnUnselectBtnPress" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Statistics">
                <Grid Background="#FFE5E5E5">
                    <StackPanel>
                        <Label x:Name="totalTracker" Content="Total Vehicles: 0"/>
                        <Label x:Name="motorizedTracker" Content="Motorized Vehicles: 0"/>
                        <Label x:Name="aerialTracker" Content="Aerial Vehicles: 0"/>
                        <Label x:Name="aquaticTracker" Content="Aquatic Vehicles: 0"/>
                        <Label x:Name="priceTracker" Content="Total Price: 0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            
            <TabItem Header="Debug">
                <Grid Background="#FFE5E5E5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Label x:Name="filenameTracker" Content="File Name: None"/>
                        <Label x:Name="directoryTracker" Content="Save Directory: "/>
                        <Separator/>
                    </StackPanel>
              
                    <TextBlock x:Name="debugOutput" Grid.Row="1" Background="Black" Foreground="Lime" Height="320" Margin="4" Padding="6" Text=""/>
                </Grid>
            </TabItem>
        </TabControl>

        <customcontrols:BongsStatusBar x:Name="statusBar" Grid.Row="2"/>
    </Grid>
</Window>
