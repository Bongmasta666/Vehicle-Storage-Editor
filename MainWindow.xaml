<Window x:Class="Bongs_Vehicle_Viewer_V2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bongs_Vehicle_Viewer_V2" 
        xmlns:customcontrols="clr-namespace:Bongs_Vehicle_Viewer_V2.Resources.CustomControls"
        mc:Ignorable="d"
        Title="Bongs Vehicle Viewer" Height="480" MinHeight="480" Width="600" WindowStartupLocation="CenterScreen">
    <Grid x:Name="rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TabControl x:Name="tabControl" Grid.Row="1">
            <TabItem Header="Registration">
                <Grid Background="WhiteSmoke">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                            
                    
                    <Grid x:Name="propertyGrid" Margin="6" Width="140" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <customcontrols:LabeledSelector x:Name="typeSelector" Grid.Row="0" LabelContent="Class" SelectionChanged="OnTypeChange"/>
                        <customcontrols:LabeledSelector x:Name="yearSelector" Grid.Row="1" LabelContent="Year"/>
                        <customcontrols:LabeledTextBox x:Name="makeTextBox" Grid.Row="2" LabelContent="Make"/>
                        <customcontrols:LabeledTextBox x:Name="modelTextBox" Grid.Row="3" LabelContent="Model"/>
                        <customcontrols:LabeledTextBox x:Name="priceTextBox" Grid.Row="4" LabelContent="Price" IsNumericField="True"/>
                        <customcontrols:LabeledSelector x:Name="stateSelector" Grid.Row="5" LabelContent="Condition"/>
                        <Grid x:Name="testGrid" Grid.Row="6" Margin="0,2,0,0"></Grid>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="6" VerticalAlignment="Center">
                        <Button x:Name="submitBtn" Content="Submit" Width="64" Margin="4,2" FontSize="14" Click="OnSubmitBtnPress"/>
                        <Button x:Name="resetBtn" Content="Reset" Width="64" Margin="4,2" FontSize="14" Click="OnResetBtnPress"/>
                    </StackPanel>
                    
                </Grid>
            </TabItem>
            <TabItem Header="Catalogue">
                <Grid Background="#FFE5E5E5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="dataGrid" Grid.Row="0" IsReadOnly="True" SelectionMode="Single" AutoGenerateColumns="False" HeadersVisibility="Column" SelectionChanged="OnVehicleSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Width="0.8*" Binding="{Binding ID}"/>
                            <DataGridTextColumn Header="Class" Width="*" Binding="{Binding Class}"/>
                            <DataGridTextColumn Header="Make" Width="*" Binding="{Binding Make}"/>
                            <DataGridTextColumn Header="Model" Width="*" Binding="{Binding Model}"/>
                            <DataGridTextColumn Header="Year" Width="*" Binding="{Binding Year}"/>
                            <DataGridTextColumn Header="Price" Width="*" Binding="{Binding Price, StringFormat=C}"/>
                            <DataGridTextColumn Header="Condition" Width="*" Binding="{Binding Condition}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="6" VerticalAlignment="Center">
                        <Button x:Name="editBtn" Content="Edit" Width="64" Margin="4,2" FontSize="14" Click="OnEditBtnPress" IsEnabled="False"/>
                        <Button x:Name="removeBtn" Content="Remove" Width="64" Margin="4,2" FontSize="14" Click="OnRemoveBtnPress" IsEnabled="False"/>
                        <Button x:Name="unselectBtn" Content="Unselect" Width="64" Margin="4,2" FontSize="14" Click="OnUnselectBtnPress" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Statistics">
                <Grid Background="#FFE5E5E5">
                    <StackPanel>
                        <Label x:Name="totalTracker" Content="Total Vehicles: 0"/>
                        <Label x:Name="motorizedTracker" Content="Motorized Vehicles: 0"/>
                        <Label x:Name="aerialTracker" Content="Aerial Vehicles: 0"/>
                        <Label x:Name="aquaticTracker" Content="Aquatic Vehicles: 0"/>
                        <Label x:Name="priceTracker" Content="Total Price: 0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2">
            <StatusBarItem HorizontalAlignment="Left">
                <Label x:Name="statusOutput" Content="System:" Padding="1" HorizontalAlignment="Left"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Label x:Name="timeLabel" Content="00:00:00" Padding="1" HorizontalAlignment="Right"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
